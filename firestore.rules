rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public reads: the booking app must show profile/viral/engagement/
    // plans/slots without a login.
    match /content/{doc} { allow read: if true; allow write: if true; }
    match /plans/{plan} { allow read: if true; allow write: if true; }
    match /viralPicks/{pick} { allow read: if true; allow write: if true; }
    match /slots/{slot} { allow read: if true; allow write: if true; }
    match /blockedDays/{day} { allow read: if true; allow write: if true; }
    // Bookings: anyone may read (to show their booking) and create via the
    // transaction; status changes are owner actions in the admin app.
    match /bookings/{booking} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
    // SECURITY NOTE — tighten before wide public distribution: enable
    // Firebase Auth for the admin app and replace the `allow write: if true`
    // lines above with `allow write: if request.auth != null;` (and
    // `allow update: if request.auth != null;` for bookings). The admin
    // APK is distributed to the owner only until then.
  }
}
